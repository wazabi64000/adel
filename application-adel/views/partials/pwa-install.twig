<div class="pwa-install" id="pwa-install" hidden role="dialog" aria-modal="true" aria-labelledby="pwa-install-title" aria-describedby="pwa-install-desc">
  <div class="pwa-install__backdrop" aria-hidden="true"></div>
  <div class="pwa-install__card">
    <div class="pwa-install__orbit" aria-hidden="true">
      <span class="pwa-install__ring pwa-install__ring--a"></span>
      <span class="pwa-install__ring pwa-install__ring--b"></span>
      <span class="pwa-install__ring pwa-install__ring--c"></span>
      <span class="pwa-install__icon-wrap">
        <img class="pwa-install__icon" src="/icons/icon-192.png" width="72" height="72" alt="">
      </span>
    </div>
    <p class="pwa-install__badge">Installation obligatoire</p>
    <h2 id="pwa-install-title">Installe Coach Adel</h2>
    <p id="pwa-install-desc" class="pwa-install__desc">
      Pour utiliser l’application, installe-la sur ton téléphone ou ton ordinateur. Sans installation, l’accès reste verrouillé.
    </p>
    <p class="pwa-install-hint" id="pwa-install-hint" hidden></p>
    <div class="pwa-install-actions">
      <button type="button" class="pwa-install__btn" id="pwa-install-btn">Installer maintenant</button>
    </div>
  </div>
</div>
