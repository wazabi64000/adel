{% extends 'layouts/admin.twig' %}

{% block heading %}Tableau de bord{% endblock %}

{% block content %}
<div class="stat-cards">
  <a class="stat-card" href="/admin/athletes"><span class="stat-card-num">{{ cards.athletes }}</span><span>Profils sportifs</span></a>
  <a class="stat-card" href="/admin/programs"><span class="stat-card-num">{{ cards.programsActive }}</span><span>Programmes actifs</span></a>
  <div class="stat-card"><span class="stat-card-num">{{ cards.exercises }}</span><span>Exercices au total</span></div>
  <div class="stat-card"><span class="stat-card-num">{{ cards.logsWeek }}</span><span>Séances enregistrées (7 j)</span></div>
  <a class="stat-card" href="/admin/articles"><span class="stat-card-num">{{ cards.articlesPublished }}</span><span>Articles publiés</span></a>
  <a class="stat-card" href="/admin/posts"><span class="stat-card-num">{{ cards.postsPublished }}</span><span>Posts publiés</span></a>
  <a class="stat-card {{ cards.unreadMessages > 0 ? 'is-alert' : '' }}" href="/admin/messages"><span class="stat-card-num">{{ cards.unreadMessages }}</span><span>Messages non lus</span></a>
  <a class="stat-card {{ cards.pendingRequests > 0 ? 'is-alert' : '' }}" href="/admin/demandes"><span class="stat-card-num">{{ cards.pendingRequests }}</span><span>Demandes en attente</span></a>
</div>

<div class="panel-grid">
  <section class="panel">
    <div class="panel-head"><h2>Activité des 30 derniers jours</h2></div>
    <div class="panel-body">
      {% if recentActivity and recentActivity | length > 0 %}
      <ul class="mini-chart">
        {% for day in recentActivity %}
        <li><span class="bar" style="height:{{ day.logs_count > 0 ? (day.logs_count * 6) : 4 }}px" title="{{ date_fr(day.log_date) }} : {{ day.logs_count }} réalisation(s)"></span><em>{{ day.logs_count }}</em></li>
        {% endfor %}
      </ul>
      <p class="muted">{{ cards.logsTotal }} réalisations au total.</p>
      {% else %}
      <p class="muted">Aucune activité enregistrée pour l'instant.</p>
      {% endif %}
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2>Sportifs les plus actifs</h2></div>
    <div class="panel-body">
      {% if topAthletes and topAthletes | length > 0 %}
      <table class="table">
        <thead><tr><th>Sportif</th><th>Séances</th><th>Réalisations</th></tr></thead>
        <tbody>
          {% for a in topAthletes %}
          <tr><td><a href="/admin/athletes/{{ a.id }}">{{ a.first_name }} {{ a.last_name }}</a></td><td>{{ a.sessions_count }}</td><td>{{ a.logs_count }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="muted">Pas encore de suivi enregistré.</p>
      {% endif %}
    </div>
  </section>
</div>

<section class="panel follow-panel">
  <div class="panel-head"><h2>{% if selectedAthlete %}{{ selectedAthlete.firstName }} {{ selectedAthlete.lastName }}{% else %}Athlètes{% endif %}</h2></div>
  <div class="panel-body">
    {% if selectedAthlete %}
    <nav class="athlete-menu" aria-label="Menu de {{ selectedAthlete.firstName }} {{ selectedAthlete.lastName }}">
      <a class="btn btn-ghost btn-sm athlete-menu-back" href="/admin">← Athlètes</a>
      <a class="btn btn-sm {{ athleteVue == 'seances' ? 'btn-primary' : 'btn-secondary' }}" href="/admin?athlete={{ selectedAthlete.id }}&vue=seances" {% if athleteVue == 'seances' %}aria-current="page"{% endif %}>Séances</a>
      <a class="btn btn-sm btn-secondary" href="/admin/programs/new?athlete_id={{ selectedAthlete.id }}">Créer un programme</a>
      <a class="btn btn-sm {{ athleteVue == 'photos' ? 'btn-primary' : 'btn-secondary' }}" href="/admin?athlete={{ selectedAthlete.id }}&vue=photos" {% if athleteVue == 'photos' %}aria-current="page"{% endif %}>Suivi photo</a>
    </nav>

    {% if athleteVue == 'seances' %}
      {% if athleteLogs and athleteLogs | length > 0 %}
        {% for day in athleteLogs %}
        <h3 class="follow-date-label">{{ date_fr(day.date) }}</h3>
        <div class="table-wrap">
          <table class="table table-compact">
            <thead><tr><th>Exercice</th><th>Séries</th><th>Reps</th><th>Charge</th><th>RPE</th><th>Ressenti</th></tr></thead>
            <tbody>
              {% for l in day.rows %}
              <tr>
                <td>{{ l.exercise_name }}</td>
                <td>{{ l.sets_done | default('—') }}</td>
                <td>{{ l.reps_done | default('—') }}</td>
                <td>{{ l.weight_used | default('—') }}</td>
                <td>{{ l.rpe | default('—') }}</td>
                <td>{{ l.feeling | default('—') }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endfor %}
      {% else %}
      <p class="muted">Aucune séance enregistrée pour cet athlète.</p>
      {% endif %}
    {% elseif athleteVue == 'photos' %}
      {% include 'admin/partials/follow-photos.twig' with { days: selectedAthlete.photoDates, emptyMessage: 'Aucune photo envoyée.' } %}
    {% else %}
      <div class="follow-stats">
        <div><b>{{ selectedAthlete.sessionsCount }}</b><span>Séances</span></div>
        <div><b>{{ selectedAthlete.frequencyPerWeek }}</b><span>par semaine</span></div>
        <div><b>{{ selectedAthlete.photoCount }}</b><span>Photos envoyées</span></div>
      </div>
      <p class="muted follow-meta">
        {% if selectedAthlete.lastSessionLabel %}Dernière séance le {{ selectedAthlete.lastSessionLabel }}.{% else %}Aucune séance enregistrée.{% endif %}
        Choisis une rubrique ci-dessus.
      </p>
    {% endif %}

    {% else %}
    {% if athleteFollowUp and athleteFollowUp | length > 0 %}
    <div class="follow-list">
      {% for a in athleteFollowUp %}
      <article class="follow-card">
        <div class="follow-head">
          <h3><a href="/admin?athlete={{ a.id }}{% if a.photoCount > 0 %}&vue=photos{% endif %}">{{ a.firstName }} {{ a.lastName }}</a></h3>
          {% if not a.isActive %}<span class="tag tag-neutral">Inactif</span>{% endif %}
        </div>
        <nav class="follow-menu" aria-label="Menu de {{ a.firstName }} {{ a.lastName }}">
          <a class="btn btn-secondary btn-sm" href="/admin?athlete={{ a.id }}&vue=seances">Séances</a>
          <a class="btn btn-primary btn-sm" href="/admin/programs/new?athlete_id={{ a.id }}">Créer un programme</a>
          <a class="btn btn-secondary btn-sm" href="/admin?athlete={{ a.id }}&vue=photos">Suivi photo</a>
        </nav>
        <p class="muted follow-meta">
          {{ a.sessionsCount }} séance{{ a.sessionsCount > 1 ? 's' : '' }} · {{ a.frequencyPerWeek }} / semaine · {{ a.photoCount }} photo{{ a.photoCount > 1 ? 's' : '' }}
        </p>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted">Aucun profil sportif pour l'instant.</p>
    {% endif %}
    {% endif %}
  </div>
</section>

{% include 'admin/partials/follow-review-modal.twig' %}

<div class="btn-row" style="margin-top:24px">
  <a class="btn btn-primary" href="/admin/programs/new">Créer un programme</a>
  <a class="btn btn-secondary" href="/admin/articles/new">Nouvel article</a>
  <a class="btn btn-secondary" href="/admin/athletes/new">Nouveau profil sportif</a>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/follow-review.js" defer></script>
{% endblock %}
