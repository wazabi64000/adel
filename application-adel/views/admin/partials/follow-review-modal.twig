<dialog class="review-modal" id="review-modal" aria-labelledby="review-title" data-csrf="{{ csrfToken }}">
  <div class="review-modal-bar">
    <h2 id="review-title">Photo</h2>
    <button type="button" class="review-close" id="review-close" aria-label="Fermer">×</button>
  </div>
  <p class="review-loading" id="review-loading">Chargement…</p>
  <div class="review-layout" id="review-layout" hidden>
    <div class="review-stage">
      <div class="review-zoom">
        <button type="button" class="btn btn-ghost btn-sm" id="review-zoom-out" aria-label="Réduire">−</button>
        <input id="review-zoom" type="range" min="1" max="3" step="0.1" value="1" aria-label="Agrandir la photo">
        <button type="button" class="btn btn-ghost btn-sm" id="review-zoom-in" aria-label="Agrandir">+</button>
        <span id="review-zoom-label">100 %</span>
      </div>
      <div class="review-thumbs" id="review-thumbs"></div>
      <div class="review-frame" id="review-frame" title="Glisser pour déplacer la photo">
        <img id="review-image" alt="">
      </div>
    </div>
    <div class="review-side">
      <h3>Commentaires</h3>
      <ul id="review-comments" class="review-comments"></ul>
      <form id="review-comment-form">
        <label for="review-comment">Ajouter un commentaire</label>
        <textarea id="review-comment" name="content" rows="3" maxlength="1000" required placeholder="Observation sur cette photo…"></textarea>
        <button class="btn btn-secondary btn-sm" type="submit">Ajouter</button>
        <p class="review-status" id="review-comment-status" role="status"></p>
      </form>
      <h3>Rapport</h3>
      <p class="muted" id="review-report-state"></p>
      <form id="review-report-form">
        <label for="review-report">Évaluation à valider</label>
        <textarea id="review-report" name="content" rows="5" maxlength="4000" required placeholder="Rapport pour l'athlète…"></textarea>
        <div class="btn-row">
          <button class="btn btn-secondary btn-sm" type="button" id="review-save">Enregistrer</button>
          <button class="btn btn-primary btn-sm" type="submit" id="review-validate">Valider et envoyer</button>
        </div>
        <p class="review-status" id="review-report-status" role="status"></p>
      </form>
    </div>
  </div>
</dialog>
