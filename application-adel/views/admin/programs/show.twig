{% extends 'layouts/admin.twig' %}

{% block heading %}{{ program.title }}{% endblock %}

{% block content %}
<div class="toolbar">
  <div class="toolbar-filters">
    <a class="btn btn-ghost btn-sm" href="/admin/programs">← Programmes</a>
    <span class="tag tag-neutral">{{ label(program.location) }}</span>
    <span class="tag tag-{{ program.status }}">{{ label(program.status) }}</span>
  </div>
  <div class="toolbar-filters">
    <a class="btn btn-secondary btn-sm" href="/admin/athletes/{{ program.athlete_id }}">{{ program.first_name }} {{ program.last_name }}</a>
    <a class="btn btn-secondary btn-sm" href="/admin/programs/{{ program.id }}/edit">Éditer</a>
    <form method="post" action="/admin/programs/{{ program.id }}?_method=DELETE" data-confirm="Supprimer ce programme et tout son contenu ?">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="btn btn-danger btn-sm" type="submit">Supprimer</button>
    </form>
  </div>
</div>

<div class="detail-grid">
  <section class="panel">
    <div class="panel-head"><h2>Informations</h2></div>
    <div class="panel-body">
      <ul class="kv">
        <li><span>Objectif</span><b>{{ program.goal | default('—') }}</b></li>
        <li><span>Niveau</span><b>{{ label(program.level) }}</b></li>
        <li><span>Durée</span><b>{{ program.weeks }} semaine(s)</b></li>
        <li><span>Début / Fin</span><b>{{ date_fr(program.start_date) | default('—') }} → {{ date_fr(program.end_date) | default('—') }}</b></li>
      </ul>
      {% if program.description %}<p class="muted" style="margin-top:12px;white-space:pre-line">{{ program.description }}</p>{% endif %}
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2>Avancement du sportif</h2></div>
    <div class="panel-body">
      <div class="stat-inline">
        <div><b>{{ stats.totalDone }}</b><span>Réalisés</span></div>
        <div><b>{{ stats.totalPlanned }}</b><span>Planifiés</span></div>
        <div><b>{{ stats.rate }}%</b><span>Taux</span></div>
      </div>
      <div class="progressbar"><span style="width:{{ stats.rate }}%"></span></div>
      {% if stats.weeks and stats.weeks | length > 0 %}
      <table class="table table-compact" style="margin-top:12px">
        <thead><tr><th>Semaine</th><th>Réalisés / planifiés</th><th>Taux</th></tr></thead>
        <tbody>
          {% for w in stats.weeks %}
          <tr><td>Semaine {{ w.weekNumber }}</td><td>{{ w.done }} / {{ w.planned }}</td><td>{{ w.rate }}%</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="muted">Aucune journée planifiée pour l'instant.</p>{% endif %}
    </div>
  </section>
</div>

<section class="panel">
  <div class="panel-head">
    <h2>Statut du programme</h2>
  </div>
  <div class="panel-body">
    <form class="inline-form" method="post" action="/admin/programs/{{ program.id }}/status">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <select name="status">
        <option value="active" {{ program.status == 'active' ? 'selected' : '' }}>Actif</option>
        <option value="draft" {{ program.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
        <option value="archived" {{ program.status == 'archived' ? 'selected' : '' }}>Archivé</option>
      </select>
      <button class="btn btn-secondary btn-sm" type="submit">Mettre à jour</button>
    </form>
  </div>
</section>

<h2 class="section-title">Journées & exercices</h2>

{% if days and days | length > 0 %}
{% for day in days %}
<section class="panel day-panel" id="day-{{ day.id }}">
  <div class="panel-head">
    <h3>
      Semaine {{ day.week_number }} — {{ day_name(day.day_of_week) }}
      {% if day.title %}· {{ day.title }}{% endif %}
      {% if day.is_rest_day %}<span class="tag tag-neutral">Repos</span>{% endif %}
    </h3>
    <div class="row-actions">
      <form method="post" action="/admin/days/{{ day.id }}?_method=DELETE" data-confirm="Supprimer cette journée et ses exercices ?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="btn btn-danger btn-sm" type="submit">Suppr. journée</button>
      </form>
    </div>
  </div>
  <div class="panel-body">
    <details class="inline-edit">
      <summary>Modifier l'en-tête de la journée</summary>
      <form class="app-form" method="post" action="/admin/days/{{ day.id }}?_method=PUT">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="field-row">
          <div class="field"><label>Titre</label><input type="text" name="title" value="{{ day.title | default('') }}"></div>
          <div class="field"><label>Focus</label><input type="text" name="focus" value="{{ day.focus | default('') }}"></div>
        </div>
        <div class="field"><label>Notes</label><textarea name="notes" rows="2">{{ day.notes | default('') }}</textarea></div>
        <div class="field field-check"><label><input type="checkbox" name="is_rest_day" value="1" {{ day.is_rest_day ? 'checked' : '' }}> Journée de repos</label></div>
        <button class="btn btn-secondary btn-sm" type="submit">Enregistrer la journée</button>
      </form>
    </details>

    {% if day.exercises and day.exercises | length > 0 %}
    <div class="exercise-list">
      {% for ex in day.exercises %}
      <article class="exercise-card">
        {% if ex.image_url %}<img class="exercise-img" src="{{ ex.image_url }}" alt="{{ ex.name }}">{% else %}<div class="exercise-img placeholder">🏋️</div>{% endif %}
        <div class="exercise-info">
          <h4>{{ ex.name }}</h4>
          <p class="muted">{{ ex.muscle_group | default('—') }} · {{ ex.equipment | default('—') }} · {{ ex.type }}</p>
          <p class="exercise-metrics"><b>{{ ex.sets | default('—') }}</b> séries × <b>{{ ex.reps | default('—') }}</b> · repos {{ ex.rest_seconds | default(0) }}s {% if ex.weight %}· {{ ex.weight }}{% endif %}</p>
          {% if ex.description %}<p class="muted">{{ ex.description }}</p>{% endif %}
        </div>
        <div class="exercise-actions">
          <details class="inline-edit">
            <summary>Éditer</summary>
            <form class="app-form" method="post" enctype="multipart/form-data" action="/admin/exercises/{{ ex.id }}?_method=PUT">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <div class="field"><label>Nom</label><input type="text" name="name" value="{{ ex.name }}" required></div>
              <div class="field"><label>Description</label><textarea name="description" rows="2">{{ ex.description | default('') }}</textarea></div>
              <div class="field-row">
                <div class="field"><label>Muscle</label><input type="text" name="muscle_group" value="{{ ex.muscle_group | default('') }}"></div>
                <div class="field"><label>Matériel</label><input type="text" name="equipment" value="{{ ex.equipment | default('') }}"></div>
              </div>
              <div class="field-row">
                <div class="field"><label>Type</label>
                  <select name="type">
                    {% for t in ['force','cardio','mobilite','gainage','etirement','autre'] %}
                    <option value="{{ t }}" {{ ex.type == t ? 'selected' : '' }}>{{ t }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="field"><label>Séries</label><input type="number" name="sets" min="0" value="{{ ex.sets | default('') }}"></div>
                <div class="field"><label>Répétitions</label><input type="text" name="reps" value="{{ ex.reps | default('') }}" placeholder="10-12 ou 30s"></div>
                <div class="field"><label>Repos (s)</label><input type="number" name="rest_seconds" min="0" value="{{ ex.rest_seconds | default('') }}"></div>
              </div>
              <div class="field-row">
                <div class="field"><label>Charge</label><input type="text" name="weight" value="{{ ex.weight | default('') }}"></div>
                <div class="field"><label>Vidéo (URL)</label><input type="url" name="video_url" value="{{ ex.video_url | default('') }}" placeholder="https://…"></div>
              </div>
              <div class="field"><label>Image — fichier</label><input type="file" name="image" accept="image/*"></div>
              <div class="field"><label>Image — lien à coller</label><input type="url" name="image_url" value="{{ ex.image_url | default('') }}" placeholder="https://…/exercice.jpg"></div>
              <p class="muted" style="margin-top:-6px;font-size:.85rem">Si tu envoies un fichier, il remplace le lien.</p>
              <button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>
            </form>
          </details>
          <form method="post" action="/admin/exercises/{{ ex.id }}?_method=DELETE" data-confirm="Supprimer cet exercice ?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button class="btn btn-danger btn-sm" type="submit">Suppr.</button>
          </form>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted">Aucun exercice pour cette journée.</p>
    {% endif %}

    <details class="inline-edit add-block">
      <summary>+ Ajouter un exercice</summary>
      <form class="app-form" method="post" enctype="multipart/form-data" action="/admin/days/{{ day.id }}/exercises">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="field"><label>Nom *</label><input type="text" name="name" required></div>
        <div class="field"><label>Description</label><textarea name="description" rows="2"></textarea></div>
        <div class="field-row">
          <div class="field"><label>Muscle</label><input type="text" name="muscle_group"></div>
          <div class="field"><label>Matériel</label><input type="text" name="equipment"></div>
        </div>
        <div class="field-row">
          <div class="field"><label>Type</label>
            <select name="type">
              <option value="force">force</option>
              <option value="cardio">cardio</option>
              <option value="mobilite">mobilité</option>
              <option value="gainage">gainage</option>
              <option value="etirement">étirement</option>
              <option value="autre">autre</option>
            </select>
          </div>
          <div class="field"><label>Séries</label><input type="number" name="sets" min="0"></div>
          <div class="field"><label>Répétitions</label><input type="text" name="reps" placeholder="10-12 ou 30s"></div>
          <div class="field"><label>Repos (s)</label><input type="number" name="rest_seconds" min="0"></div>
        </div>
        <div class="field-row">
          <div class="field"><label>Charge</label><input type="text" name="weight"></div>
          <div class="field"><label>Vidéo (URL)</label><input type="url" name="video_url" placeholder="https://…"></div>
        </div>
        <div class="field"><label>Image — fichier</label><input type="file" name="image" accept="image/*"></div>
        <div class="field"><label>Image — lien à coller</label><input type="url" name="image_url" placeholder="https://…/exercice.jpg"></div>
        <p class="muted" style="margin-top:-6px;font-size:.85rem">Upload ou lien : si les deux sont remplis, le fichier l’emporte.</p>
        <button class="btn btn-primary btn-sm" type="submit">Ajouter l'exercice</button>
      </form>
    </details>
  </div>
</section>
{% endfor %}
{% else %}
<p class="empty">Aucune journée. Ajoute une journée ci-dessous.</p>
{% endif %}

<section class="panel">
  <div class="panel-head"><h2>Ajouter une journée</h2></div>
  <div class="panel-body">
    <form class="inline-form" method="post" action="/admin/programs/{{ program.id }}/days">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field"><label>Semaine</label><input type="number" name="week_number" min="1" max="52" value="1"></div>
      <div class="field"><label>Jour</label>
        <select name="day_of_week">
          <option value="1">Lundi</option><option value="2">Mardi</option><option value="3">Mercredi</option>
          <option value="4">Jeudi</option><option value="5">Vendredi</option><option value="6">Samedi</option><option value="7">Dimanche</option>
        </select>
      </div>
      <button class="btn btn-primary btn-sm" type="submit">+ Ajouter la journée</button>
    </form>
  </div>
</section>
{% endblock %}
