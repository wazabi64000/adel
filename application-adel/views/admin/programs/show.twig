{% extends 'layouts/admin.twig' %}

{% block heading %}{{ program.title }}{% endblock %}

{% block content %}
<div class="toolbar">
  <div class="toolbar-filters">
    <a class="btn btn-ghost btn-sm" href="/admin/programs">← Programmes</a>
    <span class="tag tag-neutral">{{ label(program.location) }}</span>
    <span class="tag tag-{{ program.status }}">{{ label(program.status) }}</span>
  </div>
  <div class="toolbar-filters">
    <a class="btn btn-secondary btn-sm" href="/admin/athletes/{{ program.athlete_id }}">{{ program.first_name }} {{ program.last_name }}</a>
    <a class="btn btn-secondary btn-sm" href="/admin/programs/{{ program.id }}/edit">Éditer</a>
    <form method="post" action="/admin/programs/{{ program.id }}?_method=DELETE" data-confirm="Supprimer ce programme et tout son contenu ?">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="btn btn-danger btn-sm" type="submit">Supprimer</button>
    </form>
  </div>
</div>

<div class="detail-grid">
  <section class="panel">
    <div class="panel-head"><h2>Informations</h2></div>
    <div class="panel-body">
      <ul class="kv">
        <li><span>Objectif</span><b>{{ program.goal | default('—') }}</b></li>
        <li><span>Niveau</span><b>{{ label(program.level) }}</b></li>
        <li><span>Durée</span><b>{{ program.weeks }} semaine(s)</b></li>
        <li><span>Séances / semaine</span><b>{{ program.sessions_per_week | default('—') }}</b></li>
        <li><span>Début / Fin</span><b>{{ date_fr(program.start_date) | default('—') }} → {{ date_fr(program.end_date) | default('—') }}</b></li>
      </ul>
      {% if program.description %}<p class="muted" style="margin-top:12px;white-space:pre-line">{{ program.description }}</p>{% endif %}
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2>Avancement du sportif</h2></div>
    <div class="panel-body">
      <div class="stat-inline">
        <div><b>{{ stats.totalDone }}</b><span>Réalisés</span></div>
        <div><b>{{ stats.totalPlanned }}</b><span>Planifiés</span></div>
        <div><b>{{ stats.rate }}%</b><span>Taux</span></div>
      </div>
      <div class="progressbar"><span style="width:{{ stats.rate }}%"></span></div>
      {% if stats.weeks and stats.weeks | length > 0 %}
      <table class="table table-compact" style="margin-top:12px">
        <thead><tr><th>Semaine</th><th>Réalisés / planifiés</th><th>Taux</th></tr></thead>
        <tbody>
          {% for w in stats.weeks %}
          <tr><td>Semaine {{ w.weekNumber }}</td><td>{{ w.done }} / {{ w.planned }}</td><td>{{ w.rate }}%</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="muted">Aucune séance planifiée pour l'instant.</p>{% endif %}
    </div>
  </section>
</div>

<section class="panel">
  <div class="panel-head"><h2>Statut du programme</h2></div>
  <div class="panel-body">
    <form class="inline-form" method="post" action="/admin/programs/{{ program.id }}/status">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <select name="status">
        <option value="active" {{ program.status == 'active' ? 'selected' : '' }}>Actif</option>
        <option value="draft" {{ program.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
        <option value="archived" {{ program.status == 'archived' ? 'selected' : '' }}>Archivé</option>
      </select>
      <button class="btn btn-secondary btn-sm" type="submit">Mettre à jour</button>
    </form>
  </div>
</section>

<h2 class="section-title">Séances & exercices</h2>

{% if days and days | length > 0 %}
{% for day in days %}
<section class="panel day-panel" id="day-{{ day.id }}">
  <div class="panel-head">
    <h3>
      Semaine {{ day.week_number }} — {{ day_name(day.day_of_week) }}
      {% if day.title %}· {{ day.title }}{% endif %}
      {% if day.is_rest_day %}<span class="tag tag-neutral">Repos</span>{% endif %}
    </h3>
    <div class="row-actions">
      <span class="tag tag-neutral">{{ label(day.session_type | default('full_body')) }}{% if day.focus %} · {{ day.focus }}{% endif %}{% if day.scheduled_time %} · {{ day.scheduled_time|slice(0, 5) }}{% endif %}</span>
      <form method="post" action="/admin/days/{{ day.id }}?_method=DELETE" data-confirm="Supprimer cette séance et ses exercices ?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="btn btn-danger btn-sm" type="submit">Suppr. séance</button>
      </form>
    </div>
  </div>
  <div class="panel-body">
    <details class="inline-edit">
      <summary>Modifier la séance</summary>
      <form class="app-form" method="post" action="/admin/days/{{ day.id }}?_method=PUT">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="field-row">
          <div class="field"><label>Titre (optionnel)</label><input type="text" name="title" value="{{ day.title | default('') }}" maxlength="190"></div>
          <div class="field"><label>Partie du corps *</label>
            {% set currentFocus = day.focus | default('Tout le corps') %}
            <select name="focus" data-focus-input required>
              {% for opt in bodyFocusOptions %}
                <option value="{{ opt }}" {{ currentFocus == opt ? 'selected' : '' }}>{{ opt }}</option>
              {% endfor %}
            </select>
            <input type="hidden" name="session_type" value="{{ day.session_type | default('full_body') }}" data-session-type>
          </div>
          <div class="field">
            <label for="scheduled_time_{{ day.id }}">Heure de séance</label>
            {% set st = day.scheduled_time | default('18:00:00') %}
            <input id="scheduled_time_{{ day.id }}" name="scheduled_time" type="time" value="{{ st|slice(0, 5) }}" required>
            <small class="muted">Rappel e-mail 1 h avant (fuseau Europe/Paris).</small>
          </div>
        </div>
        <div class="field"><label>Notes</label><textarea name="notes" rows="2">{{ day.notes | default('') }}</textarea></div>
        <div class="field field-check"><label><input type="checkbox" name="is_rest_day" value="1" {{ day.is_rest_day ? 'checked' : '' }}> Journée de repos</label></div>
        <button class="btn btn-secondary btn-sm" type="submit">Enregistrer la séance</button>
      </form>
    </details>

    {% if day.exercises and day.exercises | length > 0 %}
    <div class="exercise-list">
      {% for ex in day.exercises %}
      <article class="exercise-card">
        {% if ex.image_url %}<img class="exercise-img" src="{{ ex.image_url }}" alt="{{ ex.name }}">{% else %}<div class="exercise-img placeholder">GIF</div>{% endif %}
        <div class="exercise-info">
          <h4>{{ ex.name }}</h4>
          <p class="exercise-metrics"><b>{{ ex.sets | default('—') }}</b> séries × <b>{{ ex.reps | default('—') }}</b> reps</p>
        </div>
        <div class="exercise-actions">
          <details class="inline-edit">
            <summary>Éditer</summary>
            <form class="app-form catalog-exercise-form" method="post" action="/admin/exercises/{{ ex.id }}?_method=PUT"
                  data-session-type="{{ day.session_type | default('full_body') }}" data-focus="{{ day.focus | default('') }}">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="hidden" name="type" value="{{ ex.type | default('force') }}">
              <input type="hidden" name="catalog_id" value="" data-catalog-id>
              <div class="field">
                <label>Famille</label>
                <select data-catalog-family>
                  <option value="">Toutes</option>
                  {% for f in catalogFamilies %}<option value="{{ f.id }}">{{ f.label.fr }}</option>{% endfor %}
                </select>
              </div>
              <div class="field">
                <label>Exercice (catalogue — même partie du corps)</label>
                <input type="search" data-catalog-search placeholder="Rechercher… (laisse vide pour garder {{ ex.name }})" autocomplete="off">
                <div class="catalog-results" data-catalog-results hidden></div>
                <p class="muted catalog-picked" data-catalog-picked>Actuel : {{ ex.name }}</p>
              </div>
              <div class="field-row">
                <div class="field"><label>Séries</label><input type="number" name="sets" min="0" value="{{ ex.sets | default('') }}"></div>
                <div class="field"><label>Répétitions (approx.)</label><input type="text" name="reps" value="{{ ex.reps | default('') }}" placeholder="8-12"></div>
              </div>
              <button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>
            </form>
          </details>
          <form method="post" action="/admin/exercises/{{ ex.id }}?_method=DELETE" data-confirm="Supprimer cet exercice ?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button class="btn btn-danger btn-sm" type="submit">Suppr.</button>
          </form>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted">Aucun exercice pour cette séance.</p>
    {% endif %}

    <details class="inline-edit add-block">
      <summary>+ Ajouter un exercice</summary>
      <form class="app-form catalog-exercise-form" method="post" action="/admin/days/{{ day.id }}/exercises"
            data-session-type="{{ day.session_type | default('full_body') }}" data-focus="{{ day.focus | default('') }}">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="type" value="force">
        <input type="hidden" name="catalog_id" value="" data-catalog-id required>
        <input type="hidden" name="name" value="" data-catalog-name>
        <div class="field">
          <label>Famille</label>
          <select data-catalog-family>
            <option value="">Toutes</option>
            {% for f in catalogFamilies %}<option value="{{ f.id }}">{{ f.label.fr }}</option>{% endfor %}
          </select>
        </div>
        <div class="field">
          <label>Exercice du catalogue * (GIF de la partie du corps choisie)</label>
          <input type="search" data-catalog-search placeholder="Rechercher dans cette catégorie…" autocomplete="off" required>
          <div class="catalog-results" data-catalog-results hidden></div>
          <p class="muted catalog-picked" data-catalog-picked hidden></p>
          <img class="catalog-preview" data-catalog-preview data-gif-zoom hidden alt="" title="Survoler pour agrandir · cliquer pour ouvrir">
        </div>
        <div class="field-row">
          <div class="field"><label>Séries</label><input type="number" name="sets" min="0" value="3"></div>
          <div class="field"><label>Répétitions (approx.)</label><input type="text" name="reps" placeholder="8-12" value="10"></div>
        </div>
        <button class="btn btn-primary btn-sm" type="submit">Ajouter l'exercice</button>
      </form>
    </details>
  </div>
</section>
{% endfor %}
{% else %}
<p class="empty">Aucune séance. Ajoute-en une ci-dessous.</p>
{% endif %}

<section class="panel">
  <div class="panel-head"><h2>Ajouter une séance</h2></div>
  <div class="panel-body">
    <form class="inline-form" method="post" action="/admin/programs/{{ program.id }}/days">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field"><label>Semaine</label><input type="number" name="week_number" min="1" max="52" value="1"></div>
      <div class="field"><label>Jour</label>
        <select name="day_of_week">
          <option value="1">Lundi</option><option value="2">Mardi</option><option value="3">Mercredi</option>
          <option value="4">Jeudi</option><option value="5">Vendredi</option><option value="6">Samedi</option><option value="7">Dimanche</option>
        </select>
      </div>
      <button class="btn btn-primary btn-sm" type="submit">+ Ajouter la séance</button>
    </form>
  </div>
</section>
{% endblock %}
