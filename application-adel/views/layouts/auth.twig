<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ title | default('Connexion') }}{% endblock %} — {{ appName }}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23191919'/%3E%3Crect x='7' y='14' width='18' height='4' rx='2' fill='%23ffd12f'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="auth-body">
<a class="skip" href="#main">Aller au contenu</a>
<main id="main" class="auth-main">
  <div class="auth-card">
    <a class="brand auth-brand" href="/">COACH<span>ADEL</span></a>
    {% include 'partials/flash.twig' %}
    {% block content %}{% endblock %}
  </div>
  <p class="auth-foot"><a href="/">← Retour au site</a></p>
</main>
<script src="/js/admin.js" defer></script>
</body>
</html>
