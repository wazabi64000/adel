<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ title | default('Connexion') }}{% endblock %} — {{ appName }}</title>
<meta name="robots" content="noindex, nofollow, noarchive">
{% include 'partials/pwa-head.twig' %}
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="auth-body">
<a class="skip" href="#main">Aller au contenu</a>
<main id="main" class="auth-main">
  <div class="auth-card">
    <a class="brand auth-brand" href="/">COACH<span>ADEL</span></a>
    {% include 'partials/flash.twig' %}
    {% block content %}{% endblock %}
  </div>
  <p class="auth-foot"><a href="/">← Retour au site</a></p>
</main>
{% include 'partials/pwa-update.twig' %}
<script src="/js/admin.js" defer></script>
<script src="/js/pwa.js" defer></script>
</body>
</html>
