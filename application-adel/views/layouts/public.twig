  <span class="preinscription-cta__long">Se préinscrire gratuitement</span>
  <span class="preinscription-cta__short">S'inscrire gratuit</span>
</button>
{% endif %}
<div class="mmenu" id="mobilemenu" role="dialog" aria-modal="true" aria-label="Menu de navigation" aria-hidden="true">
  <div class="mmenu-panel">
    <nav aria-label="Menu mobile">
