<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ title | default('Coach Adel') }}{% endblock %}</title>
<meta name="description" content="Un accompagnement global avec Coach Adel : activité physique, habitudes nutritionnelles, préparation mentale et plaisir de progresser à ton rythme.">
<meta name="theme-color" content="#191919">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23191919'/%3E%3Crect x='7' y='14' width='18' height='4' rx='2' fill='%23ffd12f'/%3E%3C/svg%3E">
<meta property="og:title" content="Coach Adel | Corps, nutrition et mental">
<meta property="og:description" content="Un accompagnement global fondé sur le mouvement, l'équilibre nutritionnel, la force mentale et le plaisir.">
<meta property="og:type" content="website">
<link rel="stylesheet" href="/css/site.css">
{% block head %}{% endblock %}
</head>
<body>
{% set home = currentPath == '/' %}
<a class="skip" href="#main">Aller au contenu</a>
<div class="progress" id="progress" aria-hidden="true"></div>
<div class="orbs" aria-hidden="true"><span class="orb orb-1"></span><span class="orb orb-2"></span><span class="orb orb-3"></span></div>
<div class="grain" aria-hidden="true"></div>

<div class="mobilebar">
  <a class="brand" href="{{ home ? '#accueil' : '/#accueil' }}" aria-label="Coach Adel — retour à l'accueil">COACH<span>ADEL</span></a>
  <a class="instagram-nav" href="https://www.instagram.com/adel.fitness.coaching/" target="_blank" rel="noopener" aria-label="Instagram adel.fitness.coaching">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
  </a>
  <a class="tiktok-nav" href="https://www.tiktok.com/@adel.cherif36" target="_blank" rel="noopener" aria-label="TikTok adel.cherif36">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M14.1 3v11.2a4.4 4.4 0 1 1-3.8-4.36v2.76a1.8 1.8 0 1 0 1.2 1.7V3h2.6Zm0 0c.25 2.25 1.5 3.6 3.9 3.85v2.7c-1.5-.05-2.8-.5-3.9-1.35V3Z"/></svg>
  </a>
  <a class="whatsapp-nav" href="https://wa.me/33774923253?text=Bonjour%20Adel%2C%20je%20souhaite%20%C3%A9changer%20sur%20votre%20accompagnement." target="_blank" rel="noopener" aria-label="Écrire à Coach Adel sur WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z"/><path d="M8.8 8.2c.5 3.7 2.4 5.6 6.1 6.1l1.3-1.5"/></svg>
  </a>
  <button class="burger" id="burger" aria-expanded="false" aria-controls="mobilemenu" aria-label="Ouvrir le menu"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></button>
</div>
<div class="mmenu" id="mobilemenu" role="dialog" aria-modal="true" aria-label="Menu de navigation" aria-hidden="true">
  <div class="mmenu-panel">
    <nav aria-label="Menu mobile">
      <a class="mlink" href="{{ home ? '#accueil' : '/#accueil' }}">Accueil</a>
      <a class="mlink" href="{{ home ? '#programme' : '/#programme' }}">Le programme</a>
      <a class="mlink" href="/articles">Conseils</a>
      <a class="mlink" href="{{ home ? '#rejoindre' : '/#rejoindre' }}">Rejoindre</a>
      {% if currentUser %}<a class="mlink" href="{{ currentUser.role == 'admin' ? '/admin' : '/mon-espace' }}">Mon espace</a>{% else %}<a class="mlink" href="/login">Connexion</a>{% endif %}
    </nav>
    <a class="btn btn-primary btn-block" href="{{ home ? '#rejoindre' : '/#rejoindre' }}">Intégrer le programme</a>
  </div>
</div>

<header class="topbar" aria-label="Navigation principale">
  <div class="container topbar-inner">
    <a class="brand" href="{{ home ? '#accueil' : '/#accueil' }}" aria-label="Coach Adel — retour à l'accueil">COACH<span>ADEL</span></a>
    <nav class="nav-desk" aria-label="Sections">
      <a href="{{ home ? '#accueil' : '/#accueil' }}">Accueil</a>
      <a href="{{ home ? '#programme' : '/#programme' }}">Le programme</a>
      <a href="/articles">Conseils</a>
      <a href="{{ home ? '#rejoindre' : '/#rejoindre' }}">Rejoindre</a>
      <a class="instagram-nav" href="https://www.instagram.com/adel.fitness.coaching/" target="_blank" rel="noopener" aria-label="Instagram adel.fitness.coaching">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
      </a>
      <a class="whatsapp-nav" href="https://wa.me/33774923253?text=Bonjour%20Adel%2C%20je%20souhaite%20%C3%A9changer%20sur%20votre%20accompagnement." target="_blank" rel="noopener" aria-label="Écrire à Coach Adel sur WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z"/><path d="M8.8 8.2c.5 3.7 2.4 5.6 6.1 6.1l1.3-1.5"/></svg>
      </a>
      {% if currentUser %}
        <a class="btn btn-primary" href="{{ currentUser.role == 'admin' ? '/admin' : '/mon-espace' }}">{{ currentUser.role == 'admin' ? 'Admin' : 'Mon espace' }}</a>
      {% else %}
        <a class="btn btn-primary" href="{{ home ? '#rejoindre' : '/#rejoindre' }}">Rejoindre</a>
      {% endif %}
    </nav>
  </div>
</header>

<main id="main">
{% include 'partials/flash.twig' %}
{% block content %}{% endblock %}
</main>

<footer class="sitefoot">
  <div class="container foot-grid">
    <div>
      <a class="brand" href="{{ home ? '#accueil' : '/#accueil' }}" aria-label="Coach Adel — retour à l'accueil">COACH<span>ADEL</span></a>
      <p class="foot-desc">Accompagnement personnalisé physique, nutritionnel et mental — pour une progression plus équilibrée et durable.</p>
    </div>
    <nav aria-label="Pied de page">
      <p class="foot-h">Navigation</p>
      <ul class="foot-nav">
        <li><a href="{{ home ? '#accueil' : '/#accueil' }}">Accueil</a></li>
        <li><a href="{{ home ? '#programme' : '/#programme' }}">Le programme</a></li>
        <li><a href="/articles">Conseils</a></li>
        <li><a href="{{ home ? '#rejoindre' : '/#rejoindre' }}">Rejoindre</a></li>
      </ul>
    </nav>
    <div>
      <p class="foot-h">Contact</p>
      <ul class="foot-contact">
        <li><a href="https://wa.me/33774923253?text=Bonjour%20Adel%2C%20je%20souhaite%20%C3%A9changer%20sur%20votre%20accompagnement." target="_blank" rel="noopener">WhatsApp — +33 7 74 92 32 53</a></li>
        <li><a href="mailto:annabelle.adel300@gmail.com">annabelle.adel300@gmail.com</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-h">Réseaux</p>
      <ul class="socials" aria-label="Réseaux sociaux de Coach Adel">
        <li><a href="https://www.instagram.com/adel.fitness.coaching/" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.tiktok.com/@adel.cherif36" target="_blank" rel="noopener">TikTok</a></li>
      </ul>
    </div>
  </div>
  <div class="container foot-legal">
    <span>© <span id="year">{{ year }}</span> <a class="foot-login" href="/login">adel coaching</a> — Accompagnement global.</span>
    <span>Coaching non médical : ne remplace ni médecin, ni diététicien, ni psychologue.</span>
  </div>
</footer>

{% if currentPath|slice(0, 15) != '/preinscription' %}
<button class="preinscription-cta" type="button" data-modal-open="preinscription" aria-haspopup="dialog">
  <svg class="preinscription-cta__ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
  <span class="preinscription-cta__long">Se préinscrire gratuitement</span>
  <span class="preinscription-cta__short">S'inscrire gratuit</span>
</button>
{% include 'partials/preinscription-modal.twig' %}
{% endif %}

<nav class="bottomnav" aria-label="Navigation mobile">
  <a href="{{ home ? '#accueil' : '/#accueil' }}"><span class="dot" aria-hidden="true"></span>Accueil</a>
  <a href="{{ currentUser ? (currentUser.role == 'admin' ? '/admin' : '/mon-espace') : '/login' }}"><span class="dot" aria-hidden="true"></span>Espace</a>
  <a href="/articles">Conseils</a>
  <a href="{{ home ? '#rejoindre' : '/#rejoindre' }}" class="cta">Rejoindre</a>
</nav>
<button class="totop" id="totop" aria-label="Remonter en haut de page"><span aria-hidden="true">↑</span> Top</button>

<script src="/js/site.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
