      <a class="mlink" href="{{ home ? '#programme' : '/#programme' }}">Le programme</a>
      <a class="mlink" href="/articles">Conseils</a>
      <a class="mlink" href="{{ home ? '#rejoindre' : '/#rejoindre' }}">Rejoindre</a>
