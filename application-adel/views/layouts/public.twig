  <a href="{{ currentUser ? (currentUser.role == 'admin' ? '/admin' : '/mon-espace') : '/login' }}" data-nav="espace"{% if currentPath == '/login' or currentPath starts with '/mon-espace' or currentPath starts with '/admin' or currentPath starts with '/compte' %} aria-current="true"{% endif %}>Espace</a>
