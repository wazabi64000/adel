<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% block title %}{{ title | default('Mon espace') }}{% endblock %} — {{ appName }}</title>
<meta name="robots" content="noindex, nofollow, noarchive">
{% include 'partials/pwa-head.twig' %}
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<a class="skip" href="#main">Aller au contenu</a>
<div class="admin-shell">
  {% include 'partials/athlete-nav.twig' %}
  <div class="admin-main">
    <header class="admin-top athlete-header">
      <button class="admin-burger" id="admin-burger" aria-label="Ouvrir le menu" aria-expanded="false">☰</button>
      <div class="athlete-header-center">
        <div class="athlete-brand">
          <img class="athlete-brand-mark" src="/image/logo.png" alt="" width="28" height="28">
          <span class="athlete-brand-name">COACH<span class="athlete-brand-accent">ADEL</span></span>
        </div>
        <h1 class="athlete-page-title">{% block heading %}{{ title | default('Mon espace') }}{% endblock %}</h1>
      </div>
      <div class="admin-user">
        <a class="btn btn-primary btn-sm athlete-cta-site" href="/"><span class="athlete-cta__full">Site vitrine</span><span class="athlete-cta__short">Site</span></a>
        <a href="/compte" class="athlete-user-name">{{ currentAthlete ? currentAthlete.first_name : currentUser.name }}</a>
        <form class="admin-logout" method="post" action="/logout">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="btn btn-ghost btn-sm athlete-cta-quit" type="submit"><span class="athlete-cta__full">Quitter</span><span class="athlete-cta__short">Quit</span></button>
        </form>
      </div>
    </header>
    <main id="main" class="admin-content">
      {% include 'partials/flash.twig' %}
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% include 'partials/pwa-install.twig' %}
{% include 'partials/pwa-update.twig' %}
<script src="/js/admin.js" defer></script>
<script src="/js/pwa.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
