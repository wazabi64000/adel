<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ title | default('Admin') }}{% endblock %} — {{ appName }}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23191919'/%3E%3Crect x='7' y='14' width='18' height='4' rx='2' fill='%23ffd12f'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<a class="skip" href="#main">Aller au contenu</a>
<div class="admin-shell">
  {% include 'partials/admin-nav.twig' %}
  <div class="admin-main">
    <header class="admin-top">
      <button class="admin-burger" id="admin-burger" aria-label="Ouvrir le menu" aria-expanded="false">☰</button>
      <h1 class="admin-page-title">{% block heading %}{{ title | default('Admin') }}{% endblock %}</h1>
      <div class="admin-user">
        <a href="/compte" class="admin-user-name">{{ currentUser.name }}</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="btn btn-ghost btn-sm" type="submit">Déconnexion</button>
        </form>
      </div>
    </header>
    <main id="main" class="admin-content">
      {% include 'partials/flash.twig' %}
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
<script src="/js/admin.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
