{% extends 'layouts/auth.twig' %}

{% block content %}
<h1 class="auth-title">Mot de passe oublié</h1>
<p class="auth-sub">Saisis ton e-mail : tu recevras un lien de réinitialisation.</p>

<form method="post" action="/forgot-password" novalidate class="app-form">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <div class="field">
    <label for="email">Adresse e-mail</label>
    <input id="email" name="email" type="email" value="{{ old(formData, 'email') }}" required autocomplete="email" autofocus>
    {% if formErrors.email %}<small class="field-error">{{ formErrors.email }}</small>{% endif %}
  </div>
  <button class="btn btn-primary btn-block" type="submit">Envoyer le lien</button>
</form>

<p class="auth-links"><a href="/login">← Retour à la connexion</a></p>
{% endblock %}
