{% extends 'layouts/auth.twig' %}

{% block content %}
<h1 class="auth-title">Connexion</h1>
<p class="auth-sub">Accède à ton espace coach ou sportif.</p>

{% if formErrors.global %}<div class="alert alert-error">{{ formErrors.global }}</div>{% endif %}

<form method="post" action="/login" novalidate class="app-form">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <input type="hidden" name="next" value="{{ next }}">

  <div class="field">
    <label for="email">Adresse e-mail</label>
    <input id="email" name="email" type="email" value="{{ old(formData, 'email') }}" required autocomplete="email" autofocus>
    {% if formErrors.email %}<small class="field-error">{{ formErrors.email }}</small>{% endif %}
  </div>

  <div class="field">
    <label for="password">Mot de passe</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">
    {% if formErrors.password %}<small class="field-error">{{ formErrors.password }}</small>{% endif %}
  </div>

  <button class="btn btn-primary btn-block" type="submit">Se connecter</button>
</form>

<p class="auth-links"><a href="/forgot-password">Mot de passe oublié ?</a></p>
{% endblock %}
