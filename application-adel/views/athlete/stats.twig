{% extends 'layouts/athlete.twig' %}

{% block heading %}Mes statistiques{% endblock %}

{% block content %}
<div class="stat-cards">
  <div class="stat-card"><span class="stat-card-num">{{ stats.summary.sessionsCount }}</span><span>Séances</span></div>
  <div class="stat-card"><span class="stat-card-num">{{ stats.summary.logsCount }}</span><span>Réalisations</span></div>
  <div class="stat-card"><span class="stat-card-num">{{ stats.summary.totalMinutes }}</span><span>Minutes</span></div>
  <div class="stat-card"><span class="stat-card-num">{{ stats.summary.avgRpe }}</span><span>RPE moyen</span></div>
  <div class="stat-card"><span class="stat-card-num">{{ stats.completion.rate }}%</span><span>Taux de réalisation</span></div>
</div>

<div class="detail-grid">
  <section class="panel">
    <div class="panel-head"><h2>Progression par semaine</h2></div>
    <div class="panel-body">
      {% if stats.weekly and stats.weekly | length > 0 %}
      <table class="table table-compact">
        <thead><tr><th>Semaine</th><th>Séances</th><th>Réalisations</th><th>Minutes</th><th>RPE</th></tr></thead>
        <tbody>
          {% for w in stats.weekly %}
          <tr><td>Semaine {{ w.weekNumber }}</td><td>{{ w.sessionsCount }}</td><td>{{ w.logsCount }}</td><td>{{ w.totalMinutes }}</td><td>{{ w.avgRpe }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="muted">Aucune donnée pour l'instant.</p>{% endif %}
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2>Assiduité</h2></div>
    <div class="panel-body">
      <p class="muted">{{ stats.completion.done }} exercices réalisés sur {{ stats.completion.planned }} planifiés.</p>
      <div class="progressbar"><span style="width:{{ stats.completion.rate }}%"></span></div>
      <ul class="kv" style="margin-top:12px">
        <li><span>Première séance</span><b>{{ date_fr(stats.summary.firstLog) | default('—') }}</b></li>
        <li><span>Dernière séance</span><b>{{ date_fr(stats.summary.lastLog) | default('—') }}</b></li>
      </ul>
    </div>
  </section>
</div>

<section class="panel">
  <div class="panel-head"><h2>Historique détaillé</h2></div>
  <div class="panel-body">
    {% if logs and logs | length > 0 %}
    <div class="table-wrap">
    <table class="table table-compact">
      <thead><tr><th>Date</th><th>Exercice</th><th>Séries</th><th>Reps</th><th>Charge</th><th>RPE</th><th>Ressenti</th></tr></thead>
      <tbody>
        {% for l in logs %}
        <tr>
          <td>{{ date_fr(l.log_date) }}</td>
          <td>{{ l.exercise_name }}</td>
          <td>{{ l.sets_done | default('—') }}</td>
          <td>{{ l.reps_done | default('—') }}</td>
          <td>{{ l.weight_used | default('—') }}</td>
          <td>{{ l.rpe | default('—') }}</td>
          <td>{{ l.feeling | default('—') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}<p class="muted">Aucune séance enregistrée.</p>{% endif %}
  </div>
</section>
{% endblock %}
