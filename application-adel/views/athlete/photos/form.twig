{% extends 'layouts/athlete.twig' %}

{% block heading %}{{ session ? 'Modifier la séance' : 'Nouvelle séance photo' }}{% endblock %}

{% block content %}
{% if formErrors.global %}
  <div class="alert alert-error">{{ formErrors.global }}</div>
{% endif %}

<form class="app-form panel" method="post" enctype="multipart/form-data" action="{{ session ? '/mon-espace/photos/' ~ session.id ~ '?_method=PUT' : '/mon-espace/photos' }}" id="photo-form">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <div class="field">
    <label for="session_date">Date de la séance *</label>
    <input id="session_date" name="session_date" type="date" value="{{ old(formData, 'session_date') }}" required>
    {% if formErrors.session_date %}<small class="field-error">{{ formErrors.session_date }}</small>{% endif %}
  </div>

  <div class="field">
    <label for="notes">Notes (optionnel)</label>
    <textarea id="notes" name="notes" rows="2" placeholder="Ex: séance après 4 semaines d'entraînement">{{ old(formData, 'notes') }}</textarea>
  </div>

  <div class="field fieldset">
    <label>Une photo par partie du corps</label>
    <p class="field-hint">Pour chaque partie, choisissez : prendre une photo avec l’appareil photo, ou importer une image depuis votre galerie. Vous pouvez recadrer l’aperçu avant d’enregistrer.</p>

    <div class="photo-capture-grid">
      {% for view in views %}
      <div class="photo-capture-item">
        <div class="photo-capture-header">
          <span class="photo-capture-view">{{ view }}</span>
        </div>

        <!-- Choix 1 : Appareil photo -->
        <label class="photo-action-btn photo-action-camera" for="cam_{{ view }}">
          <span class="photo-action-icon">📷</span>
          <span class="photo-action-label">Appareil photo</span>
        </label>
        <input id="cam_{{ view }}" name="photo_{{ view }}" type="file" accept="image/*" capture="environment" data-view="{{ view }}" data-source="camera" class="photo-file-input">

        <!-- Choix 2 : Importer depuis la galerie -->
        <label class="photo-action-btn photo-action-upload" for="up_{{ view }}">
          <span class="photo-action-icon">📁</span>
          <span class="photo-action-label">Importer une image</span>
        </label>
        <input id="up_{{ view }}" name="photo_{{ view }}" type="file" accept="image/*" data-view="{{ view }}" data-source="upload" class="photo-file-input">

        {% if formErrors.photo %}<small class="field-error">{{ formErrors.photo }}</small>{% endif %}

        <!-- Prévisualisation + recadrage -->
        <div class="photo-preview-wrap" id="preview-wrap_{{ view }}" data-view="{{ view }}" style="display:none">
          <div class="photo-preview-crop">
            <img id="preview_{{ view }}" class="photo-preview-img" alt="{{ view }}" draggable="false">
            <div class="crop-corner crop-corner--tl"></div>
            <div class="crop-corner crop-corner--tr"></div>
            <div class="crop-corner crop-corner--bl"></div>
            <div class="crop-corner crop-corner--br"></div>
          </div>
          <div class="photo-controls">
            <label class="crop-control">
              <span>Position X</span>
              <input type="range" min="0" max="100" value="50" data-view="{{ view }}" data-axis="x" class="crop-range">
            </label>
            <label class="crop-control">
              <span>Position Y</span>
              <input type="range" min="0" max="100" value="50" data-view="{{ view }}" data-axis="y" class="crop-range">
            </label>
            <button type="button" class="btn btn-danger btn-sm photo-remove" data-view="{{ view }}">Retirer</button>
          </div>
          <input type="hidden" name="crop_{{ view }}" value="50% 50%" class="crop-data">
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">{{ session ? 'Enregistrer la séance' : 'Enregistrer la séance' }}</button>
    <a class="btn btn-secondary" href="/mon-espace/photos">Annuler</a>
  </div>
</form>
{% endblock %}

{% block scripts %}
<script src="/js/photo-capture.js" defer></script>
{% endblock %}
