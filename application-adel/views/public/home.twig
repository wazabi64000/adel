{% extends 'layouts/public.twig' %}

{% block head %}
<script type="application/ld+json" nonce="{{ cspNonce }}">
{"@context":"https://schema.org","@graph":[
{"@type":"Person","name":"Coach Adel","jobTitle":"Coach en accompagnement global"},
{"@type":"ProfessionalService","name":"Accompagnement global — Coach Adel","areaServed":"France"}]}
</script>
{% endblock %}

{% block content %}
<!-- HERO -->
<section class="hero" id="accueil" aria-labelledby="h1">
  <div class="container hero-grid">
    <figure class="hero-media reveal">
      <img src="/image/part-2.png" width="1254" height="1254" alt="Logo CoachAdel" fetchpriority="high">
    </figure>
    <div class="hero-content">
      <p class="section-eyebrow">Corps • Nutrition • Mental</p>
      <h1 id="h1">Transforme<br><span class="hl">ton équilibre.</span></h1>
      <p class="lead">Un accompagnement global qui relie mouvement, nutrition et bien-être, pour progresser à ton rythme sans perdre le plaisir d'avancer.</p>
      <div class="btn-row">
        <a class="btn btn-primary pulse" href="#rejoindre">Intégrer le programme</a>
        <a class="btn btn-secondary" href="#conseils">Voir les conseils</a>
      </div>
      <ul class="chips" aria-label="Points clés">
        <li class="chip"><b>Physique</b> progresser</li>
        <li class="chip"><b>Nutrition</b> équilibrer</li>
        <li class="chip"><b>Mental</b> persévérer</li>
      </ul>
    </div>
  </div>
</section>

<!-- PROGRAMME -->
<section class="section" id="programme" aria-labelledby="h-programme">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-eyebrow">Le programme</p>
      <h2 id="h-programme">Un programme clair, adapté à toi.</h2>
      <p>Trois piliers pour avancer durablement, avec un suivi réel semaine après semaine.</p>
    </div>
    <ol class="pillars">
      <li class="reveal"><span class="num">01 — PHYSIQUE</span><h3>Renforcer ton corps</h3><p>Un programme personnalisé, en salle ou à la maison, avec tes séances jour par jour.</p></li>
      <li class="reveal"><span class="num">02 — NUTRITION</span><h3>Nourrir ton énergie</h3><p>Des repères simples pour mieux manger, garder le plaisir des repas et éviter les extrêmes.</p></li>
      <li class="reveal"><span class="num">03 — MENTAL</span><h3>Retrouver ton élan</h3><p>De l'écoute et des outils concrets pour entretenir motivation et confiance.</p></li>
    </ol>
    <div class="btn-row reveal" style="margin-top:28px;justify-content:center">
      <a class="btn btn-primary" href="#rejoindre">Intégrer le programme</a>
    </div>
  </div>
</section>

<!-- CONSEILS (articles) -->
<section class="section section-alt" id="conseils" aria-labelledby="h-conseils">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-eyebrow">Conseils</p>
      <h2 id="h-conseils">Des conseils pour le corps et l'esprit.</h2>
      <p>Des principes simples pour mieux bouger, mieux manger et renforcer ton équilibre.</p>
    </div>
    {% if articles and articles | length > 0 %}
    <div class="grid grid-3">
      {% for article in articles %}
      <article class="card post-card card-lift reveal">
        {% if article.cover_url %}<div class="post-media"><img src="{{ article.cover_url }}" alt="{{ article.title }}" loading="lazy"></div>{% endif %}
        <div class="post-body">
          <p class="post-meta">{{ article.category | default('Conseil') }}{% if article.read_minutes %} • {{ article.read_minutes }} min{% endif %}</p>
          <h3>{{ article.title }}</h3>
          {% if article.excerpt %}<p>{{ article.excerpt }}</p>{% endif %}
          <div class="post-more"><a class="btn btn-secondary btn-block" href="/articles/{{ article.slug }}">Lire l'article</a></div>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="btn-row" style="margin-top:24px;justify-content:center"><a class="btn btn-secondary" href="/articles">Voir tous les conseils</a></div>
    {% else %}
    <p class="lead" style="text-align:center">Les conseils du coach arrivent bientôt.</p>
    {% endif %}
  </div>
</section>

<!-- GALERIE PHOTO -->
<section class="section section-alt" id="galerie" aria-labelledby="h-galerie">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-eyebrow">Galerie</p>
      <h2 id="h-galerie">Galerie photo</h2>
      <p>Extraits des séances et du parcours. Cliquez sur une photo pour l'agrandir en modale ; utilisez les flèches pour parcourir la galerie en 3D.</p>
    </div>
    <div class="gallery3d reveal" aria-label="Galerie photo défilante en 3D">
      <div class="gallery3d-stage">
        <div class="gallery3d-track" id="gallery-track">
          {% for photo in galleryPhotos %}
          <button class="gallery3d-photo" type="button" role="button" aria-label="{{ photo.title | default('Photo') }}" data-src="{{ photo.image_url }}" data-legend="{{ photo.title | default('Photo') }}" tabindex="0">
            <img src="{{ photo.image_url }}" width="400" height="400" alt="{{ photo.title | default('Photo') }}" loading="lazy" fetchpriority="{% if loop.first %}high{% else %}auto{% endif %}">
          </button>
          {% endfor %}
        </div>
      </div>
      <button class="gallery3d-nav gallery3d-prev" type="button" aria-label="Photo précédente">&#8249;</button>
      <button class="gallery3d-nav gallery3d-next" type="button" aria-label="Photo suivante">&#8250;</button>
      <p class="gallery3d-counter" id="gallery-counter" aria-live="polite">1 sur {{ galleryPhotos | length }}</p>
    </div>
  </div>
</section>

<!-- Modale photo (réutilise les styles dialog.modal existants) -->
<dialog class="modal" id="gallery-modal" aria-label="Agrandissement photo">
  <button class="modal__close" data-modal-close aria-label="Fermer la photo">×</button>
  <div class="modal__panel">
    <img id="gallery-modal-img" src="" alt="">
    <p id="gallery-modal-caption" class="modal__sub"></p>
  </div>
</dialog>

<!-- REJOINDRE LE PROGRAMME -->
<section class="section" id="rejoindre" aria-labelledby="h-rejoindre">
  <div class="container">
    <div class="final reveal">
      <p class="section-eyebrow" style="justify-content:center">Rejoindre</p>
      <h2 id="h-rejoindre">Intègre le programme.</h2>
      <p>Pré-inscris-toi en quelques secondes : le coach valide ta demande et t'ouvre un accès personnel (programme jour par jour et suivi des séances).</p>
      <div class="btn-row">
        <button class="btn btn-primary" type="button" data-modal-open="preinscription">Se pré-inscrire gratuitement</button>
        <a class="btn btn-secondary" href="https://wa.me/33774923253?text=Bonjour%20Adel%2C%20je%20souhaite%20int%C3%A9grer%20votre%20programme." target="_blank" rel="noopener">WhatsApp</a>
      </div>
      <p class="micro">Pré-inscription gratuite • Réponse par e-mail ou WhatsApp • Sans engagement</p>
      <ul class="coords">
        <li><a href="https://wa.me/33774923253?text=Bonjour%20Adel%2C%20je%20souhaite%20int%C3%A9grer%20votre%20programme." target="_blank" rel="noopener">💬 WhatsApp — +33 7 74 92 32 53</a></li>
        <li><a href="mailto:annabelle.adel300@gmail.com">✉️ annabelle.adel300@gmail.com</a></li>
        <li><a href="https://www.instagram.com/adel.fitness.coaching/" target="_blank" rel="noopener">📸 Instagram — @adel.fitness.coaching</a></li>
        <li><a href="https://www.snapchat.com/@adelcoaching?share_id=Rv4zMyheqh4&locale=fr-FR" target="_blank" rel="noopener">👻 Snapchat — @adelcoaching</a></li>
      </ul>
    </div>
  </div>
</section>
{% endblock %}
