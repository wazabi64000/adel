{
  "name": "application-adel",
  "version": "1.0.0",
  "description": "Application Coach Adel — dashboard admin, articles, posts, profils sportifs et programmes d'entraînement (Express ESM + Twig + MySQL + Cloudinary + Brevo SMTP).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/db/setup.js",
    "db:seed": "node src/db/seed.js",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "multer": "^2.0.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "twig": "^1.17.1"
  }
}
