{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "functions": {
    "src/app.js": {
      "includeFiles": "{views,public,data,storage}/**",
      "maxDuration": 30
    },
    "src/server.js": {
      "includeFiles": "{views,public,data,storage}/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/internal/cron/session-reminders",
      "schedule": "*/10 * * * *"
    }
  ]
}
