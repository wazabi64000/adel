# =========================================================
#  Application Coach Adel — variables d'environnement
#  Copier ce fichier en `.env` et renseigner les valeurs.
#  NE JAMAIS committer le fichier `.env`.
# =========================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME="Coach Adel"

# ---- Session ----
# Chaîne aléatoire longue (ex: openssl rand -hex 32)
SESSION_SECRET=change-me-super-secret

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wazabi
DB_PASSWORD=nokia
DB_NAME=adel_app
# Toujours bas (AlwaysData / Vercel) — 2 recommandé, jamais > 5
DB_CONNECTION_LIMIT=2

# ---- Cloudinary (images exercices / articles / posts) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=coach-adel

# ---- Brevo (SMTP) ----
# Onglet Brevo > SMTP & API > onglet SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM_EMAIL=annabelle.adel300@gmail.com
MAIL_FROM_NAME="Coach Adel"

# ---- Compte administrateur créé par le seed ----
ADMIN_NAME=Adel
ADMIN_EMAIL=annabelle.adel300@gmail.com
ADMIN_PASSWORD=change-me-admin-password
